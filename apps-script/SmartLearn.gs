/* Install the combined .review/SmartLearn.gs generated by npm run build.
 * No triggers, deployments, permissions or email are enabled by this file.
 */
var SL_BASE = ['Date received', 'Source', 'Meta lead ID', 'Name', 'Business name', 'Email', 'Phone', 'Business type', 'City/service area', 'Team size', 'Main administrative challenge', 'Assigned person', 'Status', 'Next follow-up date', 'Call date/time', 'Attendance', 'Outcome', 'Notes'];
var SL_EXTRA = ['Website request ID', 'Website lead ID', 'Website payload hash', 'Contact acknowledgment at', 'UTM source', 'UTM medium', 'UTM campaign', 'UTM content', 'UTM term', 'Source ad ID', 'Source adset ID', 'Source campaign ID'];
var SL_STATE = '_SmartLearnState', SL_CONTACTS = '_SmartLearnContacts', SL_EVENTS = '_SmartLearnEvents', SL_DELIVERY = '_SmartLearnDelivery';

function slProperties() { return PropertiesService.getScriptProperties(); }
function slBook() {
  var id = slProperties().getProperty('SPREADSHEET_ID');
  if (!id) throw new Error('configuration');
  return SpreadsheetApp.openById(id);
}
function slLeads(book) {
  var name = slProperties().getProperty('LEADS_SHEET_NAME');
  if (!name) throw new Error('configuration');
  var sheet = book.getSheetByName(name);
  if (!sheet) throw new Error('schema');
  return sheet;
}
function slHeaders(sheet) { return sheet.getRange(1, 1, 1, Math.max(1, sheet.getLastColumn())).getValues()[0].map(String); }
function slCheckHeaders(sheet) {
  var headers = slHeaders(sheet);
  SL_BASE.concat(SL_EXTRA).forEach(function(name) {
    if (headers.filter(function(h) { return h === name; }).length !== 1) throw new Error('schema');
  });
  return headers;
}
function slTechnical(book, name, headers) {
  var sheet = book.getSheetByName(name);
  if (!sheet) { sheet = book.insertSheet(name); sheet.getRange(1, 1, 1, headers.length).setValues([headers]); sheet.setFrozenRows(1); }
  if (JSON.stringify(slHeaders(sheet)) !== JSON.stringify(headers)) throw new Error('schema');
  return sheet;
}
// Explicit owner-run installation only. Existing columns, rows, notes and sharing stay intact.
function initializeSmartLearn() {
  var lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    var book = slBook(), sheet = slLeads(book), headers = slHeaders(sheet);
    SL_BASE.forEach(function(name) { if (headers.filter(function(h) { return h === name; }).length !== 1) throw new Error('Existing tracker headers do not match. Stop and inspect mapping.'); });
    var missing = SL_EXTRA.filter(function(name) { return headers.indexOf(name) < 0; });
    if (missing.length) {
      var start = sheet.getLastColumn() + 1, needed = start + missing.length - 1;
      if (needed > sheet.getMaxColumns()) sheet.insertColumnsAfter(sheet.getMaxColumns(), needed - sheet.getMaxColumns());
      sheet.getRange(1, start, 1, missing.length).setValues([missing]);
    }
    slTechnical(book, SL_STATE, ['Lead ID', 'State JSON']);
    slTechnical(book, SL_CONTACTS, ['Email', 'State JSON']);
    slTechnical(book, SL_EVENTS, ['Event ID', 'Payload hash', 'Applied at']);
    slTechnical(book, SL_DELIVERY, ['Delivery key', 'State', 'Updated at']);
    SpreadsheetApp.flush();
  } finally { lock.releaseLock(); }
}
function slTable(book, name) {
  var sheet = book.getSheetByName(name);
  if (!sheet) throw new Error('schema');
  return sheet;
}
function slFind(sheet, column, key) {
  if (sheet.getLastRow() < 2) return 0;
  var values = sheet.getRange(2, column, sheet.getLastRow() - 1, 1).getValues();
  for (var i = 0; i < values.length; i++) if (String(values[i][0]) === key) return i + 2;
  return 0;
}
function slReadState(sheet, key) { var row = slFind(sheet, 1, key); return row ? JSON.parse(sheet.getRange(row, 2).getValue() || '{}') : {}; }
function slWriteState(sheet, key, state) {
  var row = slFind(sheet, 1, key) || sheet.getLastRow() + 1;
  sheet.getRange(row, 1, 1, 2).setValues([[SmartLearnCore.cell(key), JSON.stringify(state)]]);
}
function slHash(text) { return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, text, Utilities.Charset.UTF_8).map(function(b) { return ('0' + ((b + 256) % 256).toString(16)).slice(-2); }).join(''); }
function slEqual(a, b) { if (a.length !== b.length) return false; var diff = 0; for (var i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i); return diff === 0; }
function slRate(clientKey, action) {
  var p = slProperties(), now = Date.now(), windowId = Math.floor(now / 600000);
  // Bounded properties; collisions share a conservative limit. Raw IPs are never stored.
  var slot = parseInt(slHash(clientKey).slice(0, 6), 16) % 128;
  var key = 'rate.' + action + '.' + slot;
  var state = JSON.parse(p.getProperty(key) || '{}');
  if (state.window !== windowId) state = { window: windowId, count: 0 };
  if (state.count >= (action === 'status' ? 60 : 5)) return false;
  state.count++; p.setProperty(key, JSON.stringify(state));
  if (action === 'capture') {
    var global = JSON.parse(p.getProperty('rate.daily') || '{}'), day = Math.floor(now / 86400000);
    if (global.day !== day) global = { day: day, count: 0 };
    if (global.count >= 200) return false;
    global.count++; p.setProperty('rate.daily', JSON.stringify(global));
  }
  return true;
}
function slJson(data) { return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON); }
function doGet() { return slJson({ ok: false, code: 'method' }); }
function doPost(e) {
  var lock;
  try {
    var raw = e && e.postData && e.postData.contents;
    if (!raw || raw.length > 30000) return slJson({ ok: false, code: 'invalid_body' });
    var envelope = JSON.parse(raw), secret = slProperties().getProperty('APPS_SCRIPT_SECRET') || '';
    if (secret.length < 32 || typeof envelope.data !== 'string' || !Number.isFinite(envelope.timestamp) || Math.abs(Date.now() - envelope.timestamp) > 300000 || !/^[a-f0-9]{64}$/.test(envelope.signature || '')) return slJson({ ok: false, code: 'auth' });
    var expected = Utilities.computeHmacSha256Signature(envelope.timestamp + '.' + envelope.data, secret, Utilities.Charset.UTF_8).map(function(b) { return ('0' + ((b + 256) % 256).toString(16)).slice(-2); }).join('');
    if (!slEqual(expected, envelope.signature)) return slJson({ ok: false, code: 'auth' });
    var data = JSON.parse(envelope.data);
    lock = LockService.getScriptLock();
    if (!lock.tryLock(18000)) return slJson({ ok: false, code: 'busy' });
    var result = slHandle(data);
    SpreadsheetApp.flush(); // Finish durable writes before releasing the serialization lock.
    return slJson(result);
  } catch (error) {
    // Do not log payloads, personal information, authentication or upstream errors.
    return slJson({ ok: false, code: 'unavailable' });
  } finally { if (lock && lock.hasLock()) lock.releaseLock(); }
}
function slHandle(data) {
  var book = slBook(), sheet = slLeads(book), headers = slCheckHeaders(sheet);
  if (data.action === 'event') return slEvent(book, sheet, headers, data.event);
  if (!['capture', 'status'].includes(data.action) || !data.lead || !SmartLearnCore.uuid.test(data.lead.request_id || '')) return { ok: false, code: 'validation' };
  var row = slFind(sheet, headers.indexOf('Website request ID') + 1, data.lead.request_id.toLowerCase());
  if (data.action === 'status') {
    if (!slRate(String(data.clientKey || ''), 'status')) return { ok: false, code: 'rate_limited' };
    return row ? { ok: true, state: 'captured', leadId: String(sheet.getRange(row, headers.indexOf('Website lead ID') + 1).getValue()) } : { ok: true, state: 'not_found' };
  }
  if (slProperties().getProperty('CAPTURE_ENABLED') !== 'true') return { ok: false, code: 'capture_disabled' };
  var checked = SmartLearnCore.validateLead(data.lead);
  if (Object.keys(checked.errors).length) return { ok: false, code: 'validation' };
  var lead = checked.value, hash = slHash(JSON.stringify(lead));
  if (row) {
    if (String(sheet.getRange(row, headers.indexOf('Website payload hash') + 1).getValue()) !== hash) return { ok: false, code: 'conflict' };
    return { ok: true, leadId: String(sheet.getRange(row, headers.indexOf('Website lead ID') + 1).getValue()) };
  }
  if (!slRate(String(data.clientKey || ''), 'capture')) return { ok: false, code: 'rate_limited' };
  var leadId = Utilities.getUuid(), now = new Date().toISOString(), a = lead.attribution;
  var values = {
    'Date received': now, 'Source': 'Website funnel', 'Meta lead ID': '', 'Name': lead.full_name,
    'Business name': lead.business_name, 'Email': lead.email, 'Phone': lead.phone, 'Business type': lead.business_type,
    'City/service area': lead.service_area, 'Team size': lead.team_size, 'Main administrative challenge': lead.main_challenge,
    'Assigned person': slProperties().getProperty('LEAD_OWNER') || '', 'Status': 'New',
    'Website request ID': lead.request_id, 'Website lead ID': leadId, 'Website payload hash': hash,
    'Contact acknowledgment at': now, 'UTM source': a.utm_source || '', 'UTM medium': a.utm_medium || '',
    'UTM campaign': a.utm_campaign || '', 'UTM content': a.utm_content || '', 'UTM term': a.utm_term || '',
    'Source ad ID': a.ad_id || '', 'Source adset ID': a.adset_id || '', 'Source campaign ID': a.campaign_id || ''
  };
  // ID, payload hash and lead details are persisted in the same range write.
  sheet.getRange(sheet.getLastRow() + 1, 1, 1, headers.length).setValues([headers.map(function(h) { return SmartLearnCore.cell(values[h] || ''); })]);
  SpreadsheetApp.flush();
  return { ok: true, leadId: leadId };
}
function slEvent(book, sheet, headers, event) {
  if (slProperties().getProperty('EVENTS_ENABLED') !== 'true') return { ok: false, code: 'events_disabled' };
  if (!event || !['booked', 'rescheduled', 'cancelled', 'replied', 'stopped'].includes(event.type) || !/^[\w:.-]{1,180}$/.test(event.eventId || '') || !SmartLearnCore.email.test(event.email || '') || !Number.isFinite(Date.parse(event.occurredAt))) return { ok: false, code: 'validation' };
  var events = slTable(book, SL_EVENTS), eventHash = slHash(JSON.stringify(event));
  var prior = slFind(events, 1, event.eventId);
  if (prior) return String(events.getRange(prior, 2).getValue()) === eventHash ? { ok: true } : { ok: false, code: 'conflict' };
  var email = event.email.trim().toLowerCase(), contacts = slTable(book, SL_CONTACTS), contact = slReadState(contacts, email);
  if (event.type === 'stopped') contact.stopped = true;
  if (event.type === 'replied') contact.replied = true;
  if (['stopped', 'replied'].includes(event.type)) slWriteState(contacts, email, contact);
  else {
    var row = slFind(sheet, headers.indexOf('Website lead ID') + 1, event.leadId || '');
    if (!row || String(sheet.getRange(row, headers.indexOf('Email') + 1).getValue()).toLowerCase() !== email || !event.bookingId) return { ok: false, code: 'lead_mismatch' };
    var states = slTable(book, SL_STATE), state = slReadState(states, event.leadId), time = Date.parse(event.occurredAt);
    if (['booked', 'rescheduled'].includes(event.type) && (!event.dateTime || !event.timeZone)) return { ok: false, code: 'validation' };
    var matchesCancellation = event.type !== 'cancelled' || !state.bookingId || event.bookingId === state.bookingId;
    if (matchesCancellation && (!state.calendarTime || time > state.calendarTime || (time === state.calendarTime && event.type === 'cancelled'))) {
      state.calendarTime = time; state.bookingId = event.bookingId;
      state.booked = event.type !== 'cancelled'; state.cancelled = event.type === 'cancelled';
      state.confirmation = state.booked ? event : null;
      slWriteState(states, event.leadId, state);
      // Only the matched row's calendar cell is updated. Owner, status, notes,
      // attendance and outcomes remain under the team's control.
      sheet.getRange(row, headers.indexOf('Call date/time') + 1).setValue(SmartLearnCore.cell(state.booked ? (event.dateTime || '') + (event.timeZone ? ' (' + event.timeZone + ')' : '') : ''));
    }
  }
  events.getRange(events.getLastRow() + 1, 1, 1, 3).setValues([[SmartLearnCore.cell(event.eventId), eventHash, new Date().toISOString()]]);
  SpreadsheetApp.flush();
  return { ok: true };
}
function slMailConfig() {
  var p = slProperties();
  return { enabled: p.getProperty('EMAIL_ENABLED') === 'true', from: p.getProperty('SENDER_EMAIL') || '', replyTo: p.getProperty('REPLY_TO_EMAIL') || '',
    owners: p.getProperty('OWNER_NOTIFICATION_EMAILS') || '', bookingUrl: p.getProperty('BOOKING_URL') || '',
    trackerUrl: 'https://docs.google.com/spreadsheets/d/' + p.getProperty('SPREADSHEET_ID') + '/edit',
    followups: p.getProperty('FOLLOWUPS_ENABLED') === 'true', days: p.getProperty('FOLLOWUP_BUSINESS_DAYS') || '', timeZone: p.getProperty('FOLLOWUP_TIME_ZONE') || '',
    confirmationSystem: p.getProperty('BOOKING_CONFIRMATION_SYSTEM') || 'calendar' };
}
function slBusinessDaysElapsed(start, end, timeZone) {
  var day = function(value) { return Date.parse(Utilities.formatDate(new Date(value), timeZone, 'yyyy-MM-dd') + 'T00:00:00Z'); };
  var cursor = day(start), last = day(end), count = 0;
  if (!Number.isFinite(cursor) || !Number.isFinite(last)) throw new Error('Invalid lead timestamp');
  while (cursor < last) { cursor += 86400000; if (![0, 6].includes(new Date(cursor).getUTCDay())) count++; }
  return count;
}
function verifySmartLearnSender() {
  var cfg = slMailConfig(), effective = Session.getEffectiveUser().getEmail().toLowerCase();
  if (!SmartLearnCore.email.test(cfg.from) || !SmartLearnCore.email.test(cfg.replyTo) || !cfg.owners || cfg.owners.split(',').some(function(x) { return !SmartLearnCore.email.test(x.trim()); })) throw new Error('Set authorized sender, reply routing and owner/backup recipients first');
  if (cfg.from.toLowerCase() !== effective && !GmailApp.getAliases().map(function(x) { return x.toLowerCase(); }).includes(cfg.from.toLowerCase())) throw new Error('Sender is neither the executing mailbox nor an authorized Gmail send-as alias');
  return cfg; // No messages sent by this verification function.
}
// No trigger is installed automatically. Run only after authorized test delivery.
function processSmartLearnNotifications() {
  var cfg = slMailConfig(); if (!cfg.enabled) return;
  cfg = verifySmartLearnSender();
  var lock = LockService.getScriptLock(); if (!lock.tryLock(18000)) return;
  try {
    var book = slBook(), sheet = slLeads(book), headers = slCheckHeaders(sheet);
    var states = slTable(book, SL_STATE), contacts = slTable(book, SL_CONTACTS), delivery = slTable(book, SL_DELIVERY);
    var rows = sheet.getLastRow() > 1 ? sheet.getRange(2, 1, sheet.getLastRow() - 1, headers.length).getValues() : [];
    // Import-safe suppression: process every tracker row before considering mail,
    // including Meta/manual records without website IDs.
    rows.forEach(function(values) {
      var email = String(values[headers.indexOf('Email')] || '').toLowerCase().trim();
      var status = String(values[headers.indexOf('Status')] || '').toLowerCase();
      if (!SmartLearnCore.email.test(email) || !/stop|unsubscrib|do not contact|replied/.test(status)) return;
      var contact = slReadState(contacts, email);
      if (/stop|unsubscrib|do not contact/.test(status)) contact.stopped = true;
      if (/replied/.test(status)) contact.replied = true;
      slWriteState(contacts, email, contact);
    });
    var sent = 0;
    for (var i = 0; i < rows.length && sent < 10; i++) {
      var get = function(name) { return rows[i][headers.indexOf(name)]; };
      var lead = { leadId: String(get('Website lead ID')), full_name: String(get('Name')), business_name: String(get('Business name')), email: String(get('Email')).toLowerCase() };
      if (!SmartLearnCore.uuid.test(lead.leadId) || !get('Website request ID')) continue;
      var state = slReadState(states, lead.leadId), contact = slReadState(contacts, lead.email);
      // Honor team-maintained stop/reply states too, including imported suppression.
      var manualStatus = String(get('Status')).toLowerCase();
      if (/stop|unsubscrib|do not contact/.test(manualStatus)) { contact.stopped = true; slWriteState(contacts, lead.email, contact); }
      if (/replied/.test(manualStatus)) { contact.replied = true; slWriteState(contacts, lead.email, contact); }
      var blocked = Object.assign({}, state, contact);
      var kinds = ['owner'];
      if (!blocked.stopped && !blocked.replied && !blocked.booked && !blocked.cancelled) kinds.push('ack');
      var ackRow = slFind(delivery, 1, lead.leadId + ':ack');
      var ackSent = ackRow && delivery.getRange(ackRow, 2).getValue() === 'sent';
      var today = Utilities.formatDate(new Date(), cfg.timeZone || 'Etc/UTC', 'yyyy-MM-dd');
      if (cfg.followups && ackSent && state.lastContactDay !== today && SmartLearnCore.promptsAllowed(blocked) && /^(new|contacted|follow.up pending)$/i.test(String(get('Status'))) && cfg.timeZone && cfg.days) {
        var days = cfg.days.split(',').map(Number);
        if (days.some(function(d) { return !Number.isInteger(d) || d < 1 || d > 30; })) throw new Error('Invalid follow-up cadence');
        var elapsed = slBusinessDaysElapsed(get('Date received'), new Date(), cfg.timeZone);
        var due = days.filter(function(d) { return elapsed >= d; }).sort(function(a, b) { return b - a; });
        if (due.length) kinds.push('followup:' + due[0]); // Skip obsolete prompts rather than sending a backlog.
      }
      if (cfg.confirmationSystem === 'adapter' && state.booked && state.confirmation && !blocked.stopped) kinds.push('confirmation');
      for (var k = 0; k < kinds.length && sent < 10; k++) {
        var kind = kinds[k], suffix = kind === 'confirmation' ? ':' + state.confirmation.eventId : '';
        var key = lead.leadId + ':' + kind + suffix;
        if (slFind(delivery, 1, key)) continue; // sending/uncertain/sent are all held; never auto-resend.
        var mail = SmartLearnCore.message(kind, lead, cfg, state.confirmation);
        var deliveryRow = delivery.getLastRow() + 1;
        delivery.getRange(deliveryRow, 1, 1, 3).setValues([[key, 'sending', new Date().toISOString()]]);
        SpreadsheetApp.flush();
        try {
          var options = { name: 'SmartLearn', replyTo: cfg.replyTo };
          if (cfg.from.toLowerCase() !== Session.getEffectiveUser().getEmail().toLowerCase()) options.from = cfg.from;
          GmailApp.sendEmail(kind === 'owner' ? cfg.owners : lead.email, mail.subject, mail.body, options);
          delivery.getRange(deliveryRow, 2, 1, 2).setValues([['sent', new Date().toISOString()]]);
          if (kind !== 'owner') { state.lastContactDay = today; slWriteState(states, lead.leadId, state); }
        } catch (error) {
          delivery.getRange(deliveryRow, 2, 1, 2).setValues([['uncertain', new Date().toISOString()]]);
        }
        SpreadsheetApp.flush(); sent++;
        // At most one overdue booking prompt per run. Never catch up both on the same day.
        if (kind.indexOf('followup:') === 0) break;
      }
    }
  } finally { lock.releaseLock(); }
}
